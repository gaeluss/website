---
import { getI18N } from '@/i18n';
import Header from '@/components/Header.astro';
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import Seo from '@/components/Seo.astro';
import '@/styles/global.css';
import '@fontsource-variable/space-grotesk';

interface Props {
	description: string;
	title: string;
}

const { description, title } = Astro.props;
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const isProduction = import.meta.env.PROD;
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={i18n.SEO_KEYWORDS} />
		<meta name="author" content="Gaeluss" />
		<meta name="theme-color" content="#000000" />
		<Seo title={title} description={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/brand/logo.png" />
		<link rel="preload" href="/fonts/gaeluss-title.woff2" as="font" type="font/woff2" crossorigin />
		{isProduction && <GoogleAnalytics />}
	</head>
	<body>
		<Header />
		<slot />
	</body>
</html>
