---
import ArrowDisplay from './icons/arrowDisplay.astro';
import { getI18N } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LANGUAGES, defaultLang, type Lang } from '@/i18n/ui';

interface Props {
  id: string;
  variant?: 'dropdown' | 'inline';
}

const { id, variant = 'dropdown' } = Astro.props;
const panelId = `${id}-panel`;
const headingId = `${id}-heading`;

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const i18n = getI18N({ currentLocale: lang });

const current = LANGUAGES[lang];
const locales = Object.values(LANGUAGES).map((locale) => ({
  ...locale,
  href: getRelativeLocaleUrl(locale.code),
  label: locale.code.toUpperCase(),
  isCurrent: locale.code === lang,
}));
---

{variant === 'inline' ? (
  <nav class="lang-inline" aria-label={i18n.HEADER.LANGUAGE}>
    <ul class="lang-chips" role="list">
      {locales.map(({ href, code, name, label, flag: Flag, isCurrent }) => (
        <li>
          <a
            class="lang-chip focus-ring"
            href={href}
            hreflang={code}
            lang={code}
            aria-current={isCurrent ? 'page' : undefined}
          >
            <span class="flag"><Flag /></span>
            <span class="sr-only">{name} </span>
            <span>{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <div class="lang" data-lang-selector>
    <button
      type="button"
      class="lang-trigger group focus-ring"
      aria-expanded="false"
      aria-controls={panelId}
    >
      <span class="flag"><current.flag /></span>
      <span class="sr-only">{`${i18n.HEADER.LANGUAGE}: ${current.name} `}</span>
      <span class="lang-code">{current.code.toUpperCase()}</span>
      <ArrowDisplay />
    </button>

    <div id={panelId} class="lang-panel" data-lang-panel hidden>
      <p id={headingId} class="lang-heading">{i18n.HEADER.LANGUAGE}</p>
      <ul class="lang-options" role="list" aria-labelledby={headingId}>
        {locales.map(({ href, code, name, label, flag: Flag, isCurrent }) => (
          <li>
            <a
              class="lang-option focus-ring"
              href={href}
              hreflang={code}
              lang={code}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span class="flag"><Flag /></span>
              <span class="lang-name">{name}</span>
              {isCurrent ? (
                <svg class="lang-check" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M4.5 10.5l3.5 3.5 7.5-8" />
                </svg>
              ) : (
                <span class="lang-option-code" aria-hidden="true">{label}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
)}

<script>
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-lang-selector]').forEach((selector) => {
    const button = selector.querySelector('button');
    const panel = selector.querySelector<HTMLElement>('[data-lang-panel]');
    if (!button || !panel) return;

    let previewing = false;

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (!open) previewing = false;
    };

    button.addEventListener('click', () => {
      if (previewing) {
        previewing = false;
        return;
      }
      setOpen(!isOpen());
    });

    selector.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || !canHover.matches || isOpen()) return;
      setOpen(true);
      previewing = true;
    });

    selector.addEventListener('pointerleave', () => {
      if (previewing) setOpen(false);
    });

    selector.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        button.focus();
        event.stopPropagation();
      }
    });

    selector.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !selector.contains(event.relatedTarget)) {
        setOpen(false);
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (isOpen() && event.target instanceof Node && !selector.contains(event.target)) {
        setOpen(false);
      }
    });
  });
</script>

<style>
  .flag {
    position: relative;
    flex: none;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    overflow: hidden;
    border-radius: 50%;
  }

  .flag::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.2),
      inset 0 -0.375rem 0.5rem rgb(0 0 0 / 0.25);
  }

  .flag :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .lang {
    position: relative;
  }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.5rem;
    padding: 0.3125rem 0.25rem 0.3125rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.05);
    color: white;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    transition:
      background-color 0.25s ease-out,
      border-color 0.25s ease-out,
      scale 0.15s ease-out;
  }

  .lang-trigger:hover,
  .lang-trigger[aria-expanded='true'] {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.1);
  }

  .lang-trigger:active {
    scale: 0.97;
  }

  .lang-trigger > :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
    margin: 0;
    color: rgb(255 255 255 / 0.65);
  }

  .lang-panel {
    position: absolute;
    inset-block-start: calc(100% + 0.625rem);
    inset-inline-end: 0;
    z-index: 10;
    min-inline-size: 14rem;
    padding: 0.375rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1.25rem;
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--color-brand-blue) 16%, transparent), transparent 70%),
      linear-gradient(rgb(11 17 34 / 0.96), rgb(5 7 14 / 0.96));
    box-shadow:
      0 24px 60px -16px rgb(0 0 0 / 0.75),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    transform-origin: top right;
    transition:
      opacity 0.2s ease-out,
      scale 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      translate 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      display 0.25s;
    transition-behavior: allow-discrete;
  }

  .lang-panel::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    block-size: 0.75rem;
  }

  .lang-panel[hidden] {
    display: none;
    opacity: 0;
    scale: 0.96;
    translate: 0 -0.25rem;
  }

  @starting-style {
    .lang-panel:not([hidden]) {
      opacity: 0;
      scale: 0.96;
      translate: 0 -0.25rem;
    }
  }

  .lang-heading {
    margin: 0;
    padding: 0.5rem 0.75rem 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  .lang-options {
    display: grid;
    gap: 0.125rem;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding: 0.375rem 0.75rem 0.375rem 0.5rem;
    border-radius: 0.875rem;
    color: var(--color-gray-300);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      background-color 0.2s ease-out,
      color 0.2s ease-out;
  }

  .lang-option:hover {
    background: rgb(255 255 255 / 0.06);
    color: white;
  }

  .lang-option[aria-current='page'] {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-brand-blue) 24%, transparent),
      color-mix(in srgb, var(--color-brand-pink) 14%, transparent)
    );
    color: white;
  }

  .lang-option-code {
    margin-inline-start: auto;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-gray-500);
  }

  .lang-check {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin-inline-start: auto;
    fill: none;
    stroke: var(--color-brand-rose);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lang-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lang-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.75rem;
    padding: 0.375rem 0.75rem 0.375rem 0.375rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: var(--color-gray-300);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    transition:
      background-color 0.2s ease-out,
      border-color 0.2s ease-out,
      color 0.2s ease-out;
  }

  .lang-chip:hover {
    border-color: rgb(255 255 255 / 0.24);
    color: white;
  }

  .lang-chip[aria-current='page'] {
    border-color: transparent;
    background:
      linear-gradient(var(--color-night-blue), var(--color-night-blue)) padding-box,
      linear-gradient(90deg, var(--color-brand-periwinkle), var(--color-brand-rose)) border-box;
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-panel,
    .lang-panel[hidden] {
      scale: 1;
      translate: 0 0;
    }

    @starting-style {
      .lang-panel:not([hidden]) {
        scale: 1;
        translate: 0 0;
      }
    }
  }

  @media (forced-colors: active) {
    .lang-option[aria-current='page'],
    .lang-chip[aria-current='page'] {
      border: 2px solid CanvasText;
    }
  }
</style>
