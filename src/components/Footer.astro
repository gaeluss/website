---
import { getI18N } from '@/i18n';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const year = new Date().getFullYear();

const linkUnderline = 'absolute bottom-0 left-0 w-0 h-0.5 bg-white transition-all duration-500 group-hover:w-full';
const socialLink = 'transition-opacity hover:opacity-70';
---

<footer class="bg-black text-gray-300 py-12 mx-4 md:mx-16">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row md:justify-between">
      <div class="mb-8 md:mb-0">
        <h2 class="text-xl font-semibold text-white mb-4">Gaeluss</h2>
        <p class="text-gray-300">{i18n.FOOTER.DESCRIPTION}</p>
        <p class="text-gray-300">
          <a href="mailto:info@gaeluss.com" class="underline-offset-4 hover:underline">info@gaeluss.com</a>
        </p>
      </div>
      <div class="mb-8 md:mb-0">
        <h2 class="text-lg font-semibold text-white mb-4">{i18n.FOOTER.LINKS}</h2>
        <ul>
          <li>
            <a href="#about" class="relative group">
              {i18n.HEADER.VISION}
              <span class={linkUnderline}></span>
            </a>
          </li>
          <li>
            <a href="#services" class="relative group">
              {i18n.HEADER.SERVICES}
              <span class={linkUnderline}></span>
            </a>
          </li>
          <li>
            <a href="#contact" class="relative group">
              {i18n.HEADER.CONTACT}
              <span class={linkUnderline}></span>
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-white mb-4">{i18n.FOOTER.FOLLOW}</h2>
        <div class="flex space-x-4">
          <a href="https://www.linkedin.com/company/gaeluss" target="_blank" rel="noopener noreferrer" class={socialLink}><img src="/assets/icons/linkedin.svg" loading="lazy" alt="LinkedIn" class="size-7"></a>
          <a href="https://www.instagram.com/gaeluss_es" target="_blank" rel="noopener noreferrer" class={socialLink}><img src="/assets/icons/instagram.svg" loading="lazy" alt="Instagram" class="size-7"></a>
          <a href="https://x.com/gaeluss_es" target="_blank" rel="noopener noreferrer" class={socialLink}><img src="/assets/icons/twitter.svg" loading="lazy" alt="X (Twitter)" class="size-7"></a>
        </div>
      </div>
    </div>
    <div class="mt-8 text-center text-gray-500">
      <p>&copy; {year} Gaeluss. {i18n.FOOTER.RIGHTS}</p>
    </div>
  </div>
</footer>
