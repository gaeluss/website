---
import { getI18N } from '@/i18n';
import { COMPANY } from '@/data/company';
import SocialLinks from '@/components/ui/SocialLinks.astro';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const year = new Date().getFullYear();

const links = [
  { href: '#about', label: i18n.HEADER.ABOUT },
  { href: '#services', label: i18n.HEADER.SERVICES },
  { href: '#contact', label: i18n.HEADER.CONTACT },
];
---

<footer class="footer" data-footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <h2 class="footer-name">Gaeluss</h2>
        <p class="footer-text">{i18n.FOOTER.DESCRIPTION}</p>
        <a href={`mailto:${COMPANY.email}`} class="footer-mail link-underline focus-ring text-gray-200">{COMPANY.email}</a>
      </div>

      <nav aria-labelledby="footer-links-title">
        <h2 id="footer-links-title" class="footer-heading">{i18n.FOOTER.LINKS}</h2>
        <ul class="footer-list" role="list">
          {links.map(({ href, label }) => (
            <li><a href={href} class="link-underline focus-ring text-gray-200">{label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="footer-heading">{i18n.FOOTER.FOLLOW}</h2>
        <SocialLinks />
      </div>
    </div>

    <p class="footer-legal">&copy; {year} Gaeluss. {i18n.FOOTER.RIGHTS}</p>
  </div>

  <div class="footer-wordmark" aria-hidden="true">
    <span class="wordmark" data-wordmark>GAELUSS</span>
  </div>
</footer>

<script>
  import { setPointerOrigin, trackPointer } from '@/scripts/pointer';

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  const wordmark = footer?.querySelector<HTMLElement>('[data-wordmark]');

  if (footer && wordmark) {
    trackPointer(footer, (x, y) => setPointerOrigin(wordmark, x, y));
  }
</script>

<style>
  .footer {
    padding-top: clamp(4rem, 8vw, 6rem);
    overflow: clip;
    background: #000;
    color: var(--color-gray-300);
  }

  .footer-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }

  .footer-name {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: white;
  }

  .footer-text {
    max-width: 42ch;
    margin-bottom: 1rem;
    color: var(--color-gray-400);
    text-wrap: pretty;
  }

  .footer-heading {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  .footer-list {
    display: grid;
    gap: 0.625rem;
  }

  .footer-mail {
    font-weight: 500;
  }

  .footer-legal {
    margin: 3.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .footer-wordmark {
    container-type: inline-size;
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    user-select: none;
  }

  .wordmark {
    --mx: 50%;
    --my: 50%;
    --bleed: 0.08em;
    flex: none;
    margin-top: calc(-1 * var(--bleed));
    margin-right: -0.12em;
    padding-top: var(--bleed);
    font-family: var(--font-gaeluss-title);
    font-size: 18.8cqi;
    line-height: 0.75;
    letter-spacing: 0.12em;
    color: transparent;
    background:
      radial-gradient(
        18rem circle at var(--mx) var(--my),
        rgb(255 122 176 / calc(var(--glow) * 0.95)),
        rgb(91 123 255 / calc(var(--glow) * 0.7)) 45%,
        transparent 75%
      ),
      linear-gradient(90deg, color-mix(in srgb, var(--color-brand-blue) 40%, transparent), color-mix(in srgb, var(--color-brand-pink) 40%, transparent)),
      linear-gradient(rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.1));
    background-clip: text;
    mask: linear-gradient(#000 calc(var(--bleed) + 0.2625em), transparent calc(var(--bleed) + 0.735em));
    translate: 0 0.09em;
    transition: --glow 0.6s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer:hover .wordmark {
      --glow: 1;
    }
  }

  @media (width >= 48rem) {
    .footer-inner {
      padding-inline: 3rem;
    }

    .footer-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  @keyframes wordmark-rise {
    from {
      translate: 0 0.5625em;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .footer {
        view-timeline-name: --footer;
        view-timeline-inset: 0;
      }

      .wordmark {
        animation-name: wordmark-rise;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.3, 1);
        animation-fill-mode: both;
        animation-timeline: --footer;
        animation-range: entry 0% entry 100%;
      }
    }
  }
</style>
