---
import { getI18N } from '@/i18n';
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div id="home" class="relative h-dvh w-full max-w-[100vw] md:aspect-video md:h-[80vh] xl:h-full overflow-hidden">
  <div class="absolute inset-0 h-full justify-center z-10 m-auto flex flex-col items-center w-full">
    <div class="w-full h-full absolute z-10 bg-black/70"></div>
    <div class="absolute z-10 motion-safe:animate-fade-up flex justify-center items-center gap-8 flex-col">
      <h1 class="title text-4xl md:text-6xl lg:text-8xl text-white">
        <span class="sr-only">Gaeluss</span>{" "}
        <span class="flex items-center gap-5 lg:gap-10" aria-hidden="true">
          <span>G</span>
          <span>A</span>
          <span>E</span>
          <span>L</span>
          <span>U</span>
          <span>S</span>
          <span>S</span>
        </span>
      </h1>

      <p class="subtitle text-xl lg:text-2xl text-center text-wrap px-4 text-white">
        {i18n.VIDEO.SUBTITLE}
      </p>
    </div>

    <video
      loop
      muted
      playsinline
      id="main-video"
      preload="metadata"
      class="h-full w-full object-cover object-top motion-safe:animate-fade animate-duration-[2s] animate-ease-in-out"
      style="clip-path: polygon(0 0, 100% 0, 100% 85%, 50% 100%, 50% 100%, 0% 85%);"
    >
      <source src="/video.webm" type="video/webm" />
      <source src="/video.mp4" type="video/mp4" />
    </video>
  </div>
</div>

<script>
  const video = document.getElementById('main-video') as HTMLVideoElement | null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const syncPlayback = () => {
    if (!video) return;
    if (reducedMotion.matches) {
      video.pause();
      return;
    }
    video.play().catch((error) => {
      console.warn('El vídeo no se pudo reproducir automáticamente:', error);
    });
  };

  syncPlayback();
  reducedMotion.addEventListener('change', syncPlayback);
</script>

<style>
  .title {
    font-family: 'Gaeluss Title', sans-serif;
  }
  .subtitle {
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
  }
</style>
