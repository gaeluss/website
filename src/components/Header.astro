---
import LanguageSelector from './LanguageSelector.astro';

import { getI18N } from '@/i18n';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const navItems = [
    { href: '#about', label: i18n.HEADER.VISION },
    { href: '#services', label: i18n.HEADER.SERVICES },
    { href: '#contact', label: i18n.HEADER.CONTACT },
];
---

<header id="header-nav" class="fixed inset-x-0 top-0 z-20 py-3 px-8 lg:px-0">
    <div class="flex justify-between items-center max-w-7xl mx-auto">
        <a href="#home" class="shrink-0 size-16">
            <img src="/logo.svg" alt="Gaeluss" width="64" height="64">
        </a>

        <nav class="site-nav hidden lg:flex flex-1 justify-center">
            <ul class="flex gap-1 md:gap-12">
                {navItems.map(({ href, label }) => (
                    <li><a href={href} class="nav-link relative after:content-[''] after:block after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-500 after:origin-left after:mt-1 uppercase">{label}</a></li>
                ))}
            </ul>
        </nav>

        <div class="hidden lg:flex items-center">
            <LanguageSelector id="lang-desktop" />
        </div>

        <button
            id="menu-toggle"
            type="button"
            class="lg:hidden"
            aria-label={i18n.HEADER.MENU}
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg class="w-6 h-6 text-white" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
        </button>
    </div>

    <div id="mobile-menu" class="lg:hidden hidden flex-col items-center mt-4 space-y-4">
        <nav class="site-nav">
            <ul class="flex flex-col gap-4 uppercase">
                {navItems.map(({ href, label }) => (
                    <li><a href={href} class="nav-link">{label}</a></li>
                ))}
            </ul>
        </nav>
        <LanguageSelector id="lang-mobile" variant="inline" />
    </div>
</header>

<script>
    const header = document.getElementById('header-nav');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    if (header && menuToggle && mobileMenu) {
        const isMenuOpen = () => menuToggle.getAttribute('aria-expanded') === 'true';
        const setMenuOpen = (open: boolean) => {
            menuToggle.setAttribute('aria-expanded', String(open));
            mobileMenu.classList.toggle('hidden', !open);
        };

        menuToggle.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

        mobileMenu.querySelectorAll('a[href^="#"]').forEach((link) => {
            link.addEventListener('click', () => setMenuOpen(false));
        });

        header.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && isMenuOpen()) {
                setMenuOpen(false);
                menuToggle.focus();
            }
        });
    }

    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]')];

    if (CSS.supports('scroll-target-group: auto')) {
        const syncAriaCurrent = () => {
            const current = new Set(document.querySelectorAll('.site-nav a:target-current'));
            navLinks.forEach((link) => link.setAttribute('aria-current', String(current.has(link))));
        };
        syncAriaCurrent();
        document.addEventListener('scrollend', syncAriaCurrent);
    } else {
        let currentId: string | null = null;
        const setCurrent = (id: string | null) => {
            currentId = id;
            navLinks.forEach((link) => {
                const isActive = id !== null && link.hash === `#${id}`;
                link.classList.toggle('target-current', isActive);
                link.setAttribute('aria-current', String(isActive));
            });
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    setCurrent(entry.target.id);
                } else if (entry.target.id === currentId) {
                    setCurrent(null);
                }
            });
        }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });

        new Set(navLinks.map((link) => link.hash.slice(1))).forEach((id) => {
            const section = document.getElementById(id);
            if (section) observer.observe(section);
        });
    }
</script>

<style>
    #header-nav {
        scroll-target-group: auto;
    }

    @keyframes header-backdrop {
        to {
            box-shadow:
                0 5px 50px -5px rgb(0 0 0 / 0.1),
                0 0 0 1px rgb(0 0 0 / 0.3);
            background: rgb(0 0 0 / 0.3);
            backdrop-filter: blur(10px);
        }
    }

    #header-nav {
        animation-name: header-backdrop;
        animation-timing-function: linear;
        animation-fill-mode: both;
    }

    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
        #header-nav {
            animation-timeline: scroll(root);
            animation-range: 0 500px;
        }
    }

    .nav-link:is(:target-current, .target-current)::after {
        scale: 1;
    }

    #mobile-menu .nav-link:is(:target-current, .target-current) {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
    }
</style>
