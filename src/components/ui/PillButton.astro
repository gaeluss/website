---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  direction?: 'forward' | 'back';
}

const { direction = 'forward', class: className, ...attrs } = Astro.props;
---

<a class:list={['pill-button', 'focus-ring', `pill-${direction}`, className]} {...attrs}>
  {direction === 'back' && (
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
  )}
  <slot />
  {direction === 'forward' && (
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )}
</a>

<style>
  .pill-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 3.25rem;
    padding-inline: 1.75rem 1.25rem;
    border-radius: 999px;
    background: white;
    color: var(--color-night);
    font-weight: 600;
    translate: var(--pull-x, 0px) var(--pull-y, 0px);
    box-shadow: 0 0 0 0 transparent;
    transition:
      translate 0.45s cubic-bezier(0.22, 0.8, 0.24, 1),
      box-shadow 0.2s ease-out,
      scale 0.15s ease-out;
  }

  .pill-back {
    padding-inline: 1.25rem 1.75rem;
  }

  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.25s ease-out;
  }

  .pill-button:hover {
    box-shadow:
      0 0 0 4px rgb(255 255 255 / 0.12),
      0 10px 40px -8px color-mix(in srgb, var(--color-brand-pink) 70%, transparent);
  }

  .pill-forward:hover svg {
    translate: 0.25rem 0;
  }

  .pill-back:hover svg {
    translate: -0.25rem 0;
  }

  .pill-button:active {
    scale: 0.97;
  }

  @media (prefers-reduced-motion: reduce) {
    .pill-button,
    svg {
      transition-property: opacity, box-shadow, background-color, color;
    }
  }
</style>
