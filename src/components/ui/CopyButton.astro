---
interface Props {
  target: string;
  label: string;
  copiedText: string;
  failedText: string;
}

const { target, label, copiedText, failedText } = Astro.props;
---

<span class="copy">
  <button
    type="button"
    class="copy-button focus-ring"
    command="--copy"
    commandfor={target}
    aria-label={label}
    data-copied-text={copiedText}
    data-failed-text={failedText}
  >
    <svg class="copy-icon copy-icon-copy" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="9" y="9" width="11" height="11" rx="2.5" />
      <path d="M15 9V6.5A2.5 2.5 0 0 0 12.5 4h-6A2.5 2.5 0 0 0 4 6.5v6A2.5 2.5 0 0 0 6.5 15H9" />
    </svg>
    <svg class="copy-icon copy-icon-done" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    </svg>
  </button>
  <span class="copy-tip" role="status"></span>
</span>

<script>
  type CommandLikeEvent = Event & { command: string; source: Element | null };

  const timers = new WeakMap<Element, number>();
  let lastMessage = '';

  const report = (button: HTMLElement, ok: boolean) => {
    const tip = button.nextElementSibling;
    if (!tip) return;
    clearTimeout(timers.get(button));
    button.removeAttribute('data-copied');
    button.removeAttribute('data-failed');
    let message = (ok ? button.dataset.copiedText : button.dataset.failedText) ?? '';
    if (message === lastMessage) message += ' ';
    lastMessage = message;
    tip.textContent = '';
    void button.offsetWidth;
    button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
    requestAnimationFrame(() => {
      tip.textContent = message;
    });
    timers.set(
      button,
      window.setTimeout(() => {
        button.removeAttribute('data-copied');
        button.removeAttribute('data-failed');
        tip.textContent = '';
      }, 2000)
    );
  };

  const copy = async (button: HTMLElement, target: HTMLElement) => {
    const text = target.innerText.trim();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      report(button, true);
    } catch {
      report(button, false);
    }
  };

  if ('CommandEvent' in window) {
    document.addEventListener(
      'command',
      (event) => {
        const { command, source, target } = event as CommandLikeEvent;
        if (command !== '--copy') return;
        if (source instanceof HTMLElement && target instanceof HTMLElement) copy(source, target);
      },
      true
    );
  } else {
    document.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest<HTMLElement>('button[command="--copy"]');
      if (!button) return;
      const target = document.getElementById(button.getAttribute('commandfor') ?? '');
      if (target) copy(button, target);
    });
  }
</script>

<style>
  .copy {
    position: relative;
    display: inline-grid;
  }

  .copy-button {
    display: grid;
    place-items: center;
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
    border-radius: 999px;
    color: var(--color-gray-300);
    transition:
      background-color 0.15s ease-out,
      color 0.15s ease-out,
      scale 0.15s ease-out;
  }

  .copy-button:hover {
    background: rgb(255 255 255 / 0.1);
    color: white;
  }

  .copy-button:active {
    scale: 0.92;
  }

  .copy-icon {
    grid-area: 1 / 1;
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.2s ease-out,
      scale 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .copy-icon-done {
    opacity: 0;
    scale: 0.5;
    stroke-width: 2.25;
  }

  .copy-button[data-copied] {
    color: #4ade80;
  }

  .copy-button[data-copied] .copy-icon-copy {
    opacity: 0;
    scale: 0.5;
  }

  .copy-button[data-copied] .copy-icon-done {
    opacity: 1;
    scale: 1;
  }

  .copy-button[data-failed] {
    color: #fb7185;
  }

  .copy-tip {
    position: absolute;
    bottom: calc(100% + 0.625rem);
    left: 50%;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    background: white;
    color: var(--color-night);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 0.25rem;
    pointer-events: none;
    transition:
      opacity 0.2s ease-out,
      translate 0.2s ease-out;
  }

  .copy-tip:empty {
    padding: 0;
  }

  .copy-button:is([data-copied], [data-failed]) + .copy-tip {
    opacity: 1;
    translate: -50% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-icon,
    .copy-tip {
      transition-property: opacity, box-shadow, background-color, color;
    }

    .copy-icon-done,
    .copy-button[data-copied] .copy-icon-copy {
      scale: 1;
    }

    .copy-tip {
      translate: -50% 0;
    }
  }
</style>
