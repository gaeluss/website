---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<h3 class="values-title">{title}</h3>
<ul class="values" role="list">
  {items.map((item: string) => (
    <li class="value">
      <p set:html={item}></p>
    </li>
  ))}
</ul>

<style>
  .values-title {
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-rose);
  }

  .values {
    display: grid;
    margin: 0;
    padding: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    list-style: none;
  }

  .value {
    --pad: 0.5rem;
    position: relative;
    padding: var(--pad) 0 var(--pad) 1.5rem;
  }

  .value::before {
    content: '';
    position: absolute;
    top: calc(var(--pad) + 0.8em - 0.1875rem);
    left: 0.125rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-brand-periwinkle), var(--color-brand-rose));
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-brand-rose) 55%, transparent);
  }

  .value p {
    margin: 0;
    color: var(--color-gray-300);
    text-wrap: pretty;
  }
</style>
