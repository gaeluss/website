---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<h3 class="values-title">{title}</h3>
<ol class="values" role="list">
  {items.map((item, index) => (
    <li class="value">
      <span class="value-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <p set:html={item}></p>
    </li>
  ))}
</ol>

<style>
  .values-title {
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-rose);
  }

  .values {
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    list-style: none;
  }

  .values::before,
  .values::after {
    content: '';
    position: absolute;
    top: 0.8em;
    bottom: 0;
    left: 1.125rem;
    width: 1px;
    mask: linear-gradient(#000 75%, transparent);
  }

  .values::before {
    background: rgb(255 255 255 / 0.12);
  }

  .values::after {
    background: linear-gradient(in oklab, var(--color-brand-indigo), var(--color-brand-pink));
    transform-origin: top;
  }

  .value {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
  }

  .value-index {
    position: relative;
    display: grid;
    place-items: center;
    height: 1.5rem;
    margin-top: calc(0.8em - 0.75rem);
    border: 1px solid var(--color-brand-pink);
    border-radius: 999px;
    background: var(--color-night-blue);
    box-shadow: 0 0 14px -2px color-mix(in srgb, var(--color-brand-pink) 65%, transparent);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: white;
  }

  .value p {
    margin: 0;
    color: var(--color-gray-300);
    text-wrap: pretty;
  }

  @keyframes values-fill {
    from {
      scale: 1 0;
    }
  }

  @keyframes value-light {
    from {
      border-color: rgb(255 255 255 / 0.16);
      box-shadow: 0 0 14px -2px transparent;
      color: rgb(255 255 255 / 0.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .values {
        view-timeline-name: --values;
        view-timeline-inset: 60% 40%;
      }

      .values::after {
        animation-name: values-fill;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --values;
        animation-range: cover 0.8em cover 100%;
      }

      .value-index {
        animation-name: value-light;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view(block 60% 40%);
        animation-range: cover 0% cover 100%;
      }
    }
  }
</style>
