---
import { getI18N } from '@/i18n';
import { COMPANY } from '@/data/company';
import PillButton from '@/components/ui/PillButton.astro';
import CopyButton from '@/components/ui/CopyButton.astro';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { email } = COMPANY;
---

<section id="contact" tabindex="-1" class="contact">
  <div class="contact-card" data-contact>
    <div class="contact-sky" aria-hidden="true">
      <div class="contact-stars starfield"></div>
      <div class="contact-spotlight"></div>
      <div class="contact-atmosphere"></div>
      <div class="contact-planet">
        <div class="planet-halo"></div>
        <div class="planet-body"></div>
      </div>
    </div>

    <div class="contact-body">
      <h2 class="contact-title section-title">{i18n.PREFOOTER.TITLE}</h2>
      <p class="contact-text">{i18n.PREFOOTER.DESCRIPTION}</p>

      <div class="contact-actions">
        <PillButton href={`mailto:${email}`} data-magnetic>
          <span>{i18n.PREFOOTER.BUTTON}</span>
        </PillButton>

        <div class="contact-email">
          <span id="contact-email">{email}</span>
          <CopyButton
            target="contact-email"
            label={i18n.PREFOOTER.COPY}
            copiedText={i18n.PREFOOTER.COPIED}
            failedText={i18n.PREFOOTER.COPY_FAILED}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { reducedMotion, setPointerOrigin, trackPointer } from '@/scripts/pointer';

  const card = document.querySelector<HTMLElement>('[data-contact]');
  const magnet = card?.querySelector<HTMLElement>('[data-magnetic]');

  if (card && magnet) {
    const setPull = (x: number, y: number) => {
      magnet.style.setProperty('--pull-x', `${x}px`);
      magnet.style.setProperty('--pull-y', `${y}px`);
    };

    trackPointer(
      card,
      (x, y) => {
        setPointerOrigin(card, x, y);
        if (reducedMotion.matches) return;
        const rect = magnet.getBoundingClientRect();
        const dx = x - rect.left - rect.width / 2;
        const dy = y - rect.top - rect.height / 2;
        const near = Math.hypot(dx, dy) < rect.width;
        const pull = (distance: number) => (near ? Math.min(10, Math.max(-10, distance * 0.25)) : 0);
        setPull(pull(dx), pull(dy));
      },
      { onLeave: () => setPull(0, 0) }
    );
  }
</script>

<style>
  .contact {
    padding: clamp(5rem, 10vw, 8rem) 1rem clamp(2rem, 5vw, 4rem);
  }

  .contact-card {
    --mx: 50%;
    --my: 30%;
    position: relative;
    isolation: isolate;
    overflow: clip;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 7rem) 1.5rem clamp(10rem, 22vw, 17rem);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 2rem;
    background: linear-gradient(var(--color-night-blue), var(--color-night));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    text-align: center;
  }

  .contact-sky,
  .contact-sky > * {
    position: absolute;
    pointer-events: none;
  }

  .contact-sky {
    inset: 0;
    z-index: -1;
  }

  .contact-stars {
    inset: -3rem 0;
    mask: linear-gradient(#000 40%, transparent 85%);
  }

  .contact-spotlight {
    inset: 0;
    background: radial-gradient(32rem circle at var(--mx) var(--my), rgb(125 151 255 / 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .contact-atmosphere {
    inset: 0;
    background:
      radial-gradient(45% 40% at 30% 100%, color-mix(in srgb, var(--color-brand-blue) 45%, transparent), transparent),
      radial-gradient(45% 40% at 70% 100%, color-mix(in srgb, var(--color-brand-pink) 35%, transparent), transparent);
  }

  .contact-planet {
    left: 50%;
    top: calc(100% - clamp(5rem, 13vw, 9rem));
    width: max(150%, 64rem);
    aspect-ratio: 1;
    translate: -50% 0;
  }

  .planet-halo,
  .planet-body,
  .planet-body::after {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .planet-halo {
    inset: -3px;
    background: linear-gradient(90deg, var(--color-brand-blue), #7b3fe4 50%, var(--color-brand-pink));
    filter: blur(28px);
  }

  .planet-body {
    background: radial-gradient(circle at 50% 0%, #141c38, var(--color-night) 30%);
  }

  .planet-body::after {
    content: '';
    padding: 1.5px;
    background: linear-gradient(90deg, transparent 18%, var(--color-brand-periwinkle) 34%, #fff 50%, var(--color-brand-rose) 66%, transparent 82%);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  .contact-body {
    display: grid;
    justify-items: center;
  }

  .contact-title {
    max-width: 18ch;
    margin-bottom: 1.25rem;
  }

  .contact-text {
    max-width: 46ch;
    margin-bottom: 2.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--color-gray-300);
    text-wrap: pretty;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.25rem;
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 3.25rem;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    backdrop-filter: blur(8px);
    color: var(--color-gray-200);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-card:hover .contact-spotlight {
      opacity: 1;
    }
  }

  @media (width >= 48rem) {
    .contact {
      padding-inline: 3rem;
    }
  }

  @keyframes contact-planet-rise {
    from {
      translate: -50% 9rem;
    }
  }

  @keyframes contact-glow-in {
    from {
      opacity: 0;
    }
  }

  @keyframes contact-stars-drift {
    from {
      translate: 0 2.5rem;
    }
    to {
      translate: 0 -2.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .contact {
        view-timeline-name: --contact;
        view-timeline-inset: 0;
      }

      .contact-planet {
        animation-name: contact-planet-rise;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.3, 1);
        animation-fill-mode: both;
        animation-timeline: --contact;
        animation-range: entry 10% cover 50%;
      }

      .contact-atmosphere {
        animation-name: contact-glow-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --contact;
        animation-range: entry 30% cover 50%;
      }

      .contact-stars {
        animation-name: contact-stars-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --contact;
        animation-range: cover 0% cover 100%;
      }
    }
  }
</style>
