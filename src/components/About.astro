---
import { getI18N } from '@/i18n';
import LogoStage from '@/components/about/LogoStage.astro';
import ValuesList from '@/components/about/ValuesList.astro';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const values = [
  i18n.ABOUT.LIST_1,
  i18n.ABOUT.LIST_2,
  i18n.ABOUT.LIST_3,
  i18n.ABOUT.LIST_4,
  i18n.ABOUT.LIST_5,
];
---

<section id="about" tabindex="-1" class="about relative isolate w-full">
  <div class="about-blend" aria-hidden="true"></div>
  <svg class="about-peak" aria-hidden="true" viewBox="0 0 100 10" preserveAspectRatio="none" focusable="false">
    <defs>
      <linearGradient id="peak-rim" x1="0" x2="1" y1="0" y2="0">
        <stop class="peak-stop peak-stop-fade" offset="0" />
        <stop class="peak-stop peak-stop-blue" offset="0.22" />
        <stop class="peak-stop peak-stop-white" offset="0.5" />
        <stop class="peak-stop peak-stop-pink" offset="0.78" />
        <stop class="peak-stop peak-stop-fade peak-stop-pink" offset="1" />
      </linearGradient>
    </defs>
    <polygon class="peak-body" points="0,10 50,0 100,10" />
    <polyline class="peak-edge peak-glow" points="0,10 50,0 100,10" />
    <polyline class="peak-edge" points="0,10 50,0 100,10" />
  </svg>

  <div class="about-inner">
    <LogoStage />

    <div class="about-copy">
      <h2 class="about-title">{i18n.ABOUT.TITLE}</h2>
      <p set:html={i18n.ABOUT.DESCRIPTION} class="about-text"></p>
      <ValuesList title={i18n.ABOUT.SUBTITLE} items={values} />
    </div>
  </div>
</section>

<style>
  .about {
    --peak: var(--about-peak);
    margin-top: calc(-1 * var(--peak));
    padding-top: max(7rem, calc(var(--peak) + 2rem));
    padding-bottom: clamp(6rem, 12vw, 10rem);
    overflow-x: clip;
  }

  .about-peak {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: -1;
    width: 100%;
    height: calc(var(--peak) + 1px);
    overflow: visible;
    transform-origin: bottom;
  }

  .peak-body {
    fill: var(--color-night);
  }

  .peak-edge {
    fill: none;
    stroke: url(#peak-rim);
    stroke-width: 1.5px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .peak-glow {
    stroke-width: 9px;
    opacity: 0.22;
  }

  .peak-stop {
    stop-color: var(--color-brand-periwinkle);
  }

  .peak-stop-white {
    stop-color: white;
  }

  .peak-stop-pink {
    stop-color: var(--color-brand-rose);
  }

  .peak-stop-fade {
    stop-opacity: 0;
  }

  .about-blend {
    position: absolute;
    inset-inline: 0;
    bottom: calc(100% - var(--peak) - 1px);
    z-index: -1;
    height: 60vh;
    background: linear-gradient(
      in oklab,
      transparent,
      color-mix(in oklab, var(--color-night) 55%, transparent) 55%,
      var(--color-night)
    );
    opacity: 0;
    pointer-events: none;
  }

  .about-inner {
    display: grid;
    gap: 3.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .about-copy {
    color: white;
  }

  .about-title {
    margin-bottom: 1.25rem;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .about-text {
    max-width: 60ch;
    margin-bottom: 2.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    color: var(--color-gray-300);
    text-wrap: pretty;
  }

  @media (width >= 48rem) {
    .about-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      gap: clamp(3rem, 6vw, 6rem);
      padding-inline: 3rem;
    }
  }

  @keyframes about-peak-flatten {
    to {
      scale: 1 0;
    }
  }

  @keyframes about-blend-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .about {
        view-timeline-name: --about;
        view-timeline-inset: 0;
      }

      .about-peak {
        animation-name: about-peak-flatten;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --about;
        animation-range: entry 30% entry 90%;
      }

      .about-blend {
        animation-name: about-blend-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --about;
        animation-range: entry 30% entry 90%;
      }
    }
  }
</style>
