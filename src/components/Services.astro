---
import { getI18N } from '@/i18n';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const card = 'bg-gray-800 rounded-lg shadow-md p-8 xl:p-12 2xl:p-20 relative group overflow-hidden border border-gray-400';
const iconRow = 'flex flex-wrap justify-center gap-8 2xl:gap-16 mb-10 lg:mb-20';
const icon = 'size-20 xl:size-24 2xl:size-28 opacity-70';
---

<section id="services" tabindex="-1" class="py-20 mx-4 md:mx-12">
  <div class="container mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-100 mb-12 text-center">{i18n.SERVICES.TITLE}</h2>
    <div class="grid gap-6 grid-cols-1 md:grid-cols-4 lg:grid-cols-6">
      <div class:list={[card, 'md:col-span-2 lg:col-span-4']}>
        <div class="absolute inset-0 bg-blue-900 opacity-0 group-hover:opacity-20 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class={iconRow}>
            <img src="/assets/icons/code_rate.svg" alt="" loading="lazy" class:list={[icon, 'hidden lg:block']}>
            <img src="/assets/icons/terminal.svg" alt="" loading="lazy" class:list={[icon, 'hidden lg:block']}>
            <img src="/assets/icons/api.svg" alt="" loading="lazy" class:list={[icon, 'hidden xl:block']}>
            <img src="/assets/icons/web.svg" alt="" loading="lazy" class={icon}>
          </div>

          <h3 class="text-xl font-semibold text-white mb-4">{i18n.SERVICES.WEB_DEVELOPMENT}</h3>
          <p set:html={i18n.SERVICES.WEB_DEVELOPMENT_DESCRIPTION} class="text-white text-pretty"></p>
        </div>
      </div>
      <div class:list={[card, 'md:col-span-2 lg:col-span-2']}>
        <div class="absolute inset-0 bg-pink-900 opacity-0 group-hover:opacity-20 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class={iconRow}>
            <img src="/assets/icons/movil2.svg" alt="" loading="lazy" class={icon}>
            <img src="/assets/icons/pc_movil.svg" alt="" loading="lazy" class={icon}>
          </div>

          <h3 class="text-xl font-semibold text-white mb-4">{i18n.SERVICES.MOBILE_DEVELOPMENT}</h3>
          <p set:html={i18n.SERVICES.MOBILE_DEVELOPMENT_DESCRIPTION} class="text-white text-pretty"></p>
        </div>
      </div>
      <div class:list={[card, 'md:col-span-2 lg:col-span-2']}>
        <div class="absolute inset-0 bg-pink-900 opacity-0 group-hover:opacity-20 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class={iconRow}>
            <img src="/assets/icons/diseño_ordenador2.svg" alt="" loading="lazy" class={icon}>
          </div>

          <h3 class="text-xl font-semibold text-white mb-4">{i18n.SERVICES.DESIGN}</h3>
          <p set:html={i18n.SERVICES.DESIGN_DESCRIPTION} class="text-white text-pretty"></p>
        </div>
      </div>
      <div class:list={[card, 'md:col-span-2 lg:col-span-4']}>
        <div class="absolute inset-0 bg-blue-900 opacity-0 group-hover:opacity-20 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <div class={iconRow}>
            <img src="/assets/icons/persona_pantallas.svg" alt="" loading="lazy" class:list={[icon, 'hidden lg:block']}>
            <img src="/assets/icons/manos_juntas.svg" alt="" loading="lazy" class={icon}>
            <img src="/assets/icons/conferencia.svg" alt="" loading="lazy" class={icon}>
          </div>

          <h3 class="text-xl font-semibold text-white mb-4">{i18n.SERVICES.CONSULTING}</h3>
          <p set:html={i18n.SERVICES.CONSULTING_DESCRIPTION} class="text-white text-pretty"></p>
        </div>
      </div>
    </div>
  </div>
</section>
